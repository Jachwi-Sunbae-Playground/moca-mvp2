{
  "description": "문서를 수정한 직후 정합성을 검사한다. 판단 로직은 .github/scripts/docs_hook.sh 한 곳에 둔다.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".github/scripts/docs_hook.sh",
            "timeout": 30,
            "statusMessage": "문서 정합성 검사 중"
          }
        ]
      }
    ]
  }
}
